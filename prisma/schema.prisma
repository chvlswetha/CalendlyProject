// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  name      String
  slug      String   @unique
  timezone  String   @default("UTC")
  CreatedAt DateTime @default(now())
  UpdatedAt DateTime @updatedAt

  //user has many event types. Represents as EvenTypes array
  eventTypes             EventType[] //One user can have many event types. and an event type belongs to a user(one to many)
  availabilityRules      AvailabilityRule[]
  availabilityExceptions AvailabiltyException[]
  slots                  Slot[]
  booking                Booking[]              @relation("HostBookings")

  @@map("users") //maps the entire model as users table in database
}

model EventType {
  id                  Int      @id @default(autoincrement())
  hostId              Int
  title               String
  description         String?
  slug                String
  durationMinutes     Int
  isActive            Boolean  @default(true)
  locationType        String?  @default("online")
  locationValue       String?
  bufferBeforeMinutes Int?     @default(0)
  bufferAfterMinutes  Int?     @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  host User @relation(fields: [hostId], references: [id], onDelete: Cascade) //primary key - id from a user table is referenced as hostId in eventType table. This is a foreign key relationship. One user can have many event types.
  //OnDelete Cascade is like - if a user is deleted corresponding user events also gets deleted here

  slots   Slot[]
  booking Booking[]

  @@unique([hostId, slug])
  @@map("event_types") //maps the entire model as event_types table in database
}

model AvailabilityRule {
  id        Int      @id @default(autoincrement())
  userId    Int
  weekday   Int
  startTime String
  endTime   String
  timezone  String   @default("UTC")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, weekday])
  @@map("availability_rules")
}

model AvailabiltyException {
  id        Int      @id @default(autoincrement())
  userId    Int
  date      DateTime @db.Date
  type      String
  startTime String?
  endTime   String?
  timezone  String   @default("UTC")
  reason    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@map("availability_exceptions")
}

model Slot {
  id          Int      @id @default(autoincrement())
  hostId      Int
  eventTypeId Int
  startAt     DateTime
  endAt       DateTime
  status      String   @default("AVAILABLE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  host      User      @relation(fields: [hostId], references: [id], onDelete: Cascade)
  eventType EventType @relation(fields: [eventTypeId], references: [id], onDelete: Cascade)

  booking Booking[]

  @@unique([eventTypeId, startAt, endAt])
  @@index([hostId, startAt])
  @@index([eventTypeId, startAt, endAt])
  @@map("slots")
}

model Booking {
  id              Int       @id @default(autoincrement())
  hostId          Int
  eventTypeId     Int
  slotId          Int
  inviteeEmail    String
  inviteeNotes    String?
  status          String    @default("PENDING")
  meetlink        String?
  calendarEventId String?
  cancelledAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  host      User      @relation("HostBookings", fields: [hostId], references: [id], onDelete: Cascade)
  eventType EventType @relation(fields: [eventTypeId], references: [id], onDelete: Cascade)
  slot      Slot      @relation(fields: [slotId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([hostId, createdAt])
  @@index([inviteeEmail])
  @@map("bookings")
}
